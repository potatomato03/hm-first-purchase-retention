{
  "datasets": [
    {
      "name": "first_orders",
      "displayName": "first_orders",
      "queryLines": [
        "SELECT *, CAST(returned_90d AS INT) AS came_back,\n",
        "       CASE WHEN first_date <= DATE'2020-03-26' THEN CAST(returned_180d AS INT) END AS came_back_180,\n",
        "       CASE items_band WHEN '1' THEN '01' WHEN '2' THEN '02' WHEN '3' THEN '03'\n",
        "            WHEN '4-5' THEN '04-05' WHEN '6-9' THEN '06-09' ELSE '10+' END AS items_in_basket\n",
        "FROM workspace.hm_retention.silver_first_orders"
      ]
    },
    {
      "name": "cohorts",
      "displayName": "cohorts",
      "queryLines": [
        "SELECT date_format(cohort_month, 'yyyy-MM') AS cohort, k, retention_pct FROM workspace.hm_retention.gold_cohort_retention"
      ]
    },
    {
      "name": "weekly_channel",
      "displayName": "weekly_channel",
      "queryLines": [
        "SELECT * FROM workspace.hm_retention.gold_weekly_channel"
      ]
    },
    {
      "name": "burn_in",
      "displayName": "burn_in",
      "queryLines": [
        "SELECT * FROM workspace.hm_retention.gold_burn_in"
      ]
    },
    {
      "name": "return_window",
      "displayName": "return_window",
      "queryLines": [
        "SELECT * FROM workspace.hm_retention.gold_return_window"
      ]
    },
    {
      "name": "odds_ratios",
      "displayName": "odds_ratios",
      "queryLines": [
        "SELECT driver_group, CAST(odds_ratio AS DOUBLE) AS odds_ratio,\n",
        "       round((CAST(odds_ratio AS DOUBLE) - 1) * 100, 1) AS change_in_odds_pct\n",
        "FROM workspace.hm_retention.gold_odds_ratios"
      ]
    }
  ],
